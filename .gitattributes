# Auto detect text files and perform LF normalization
* text=auto

# The patch and its applier are consumed inside the Linux build container
# (Dockerfile: COPY patches/ -> git apply). A CRLF checkout on Windows would make
# `git apply` reject the patch and `bash` choke on the script, so pin them to LF
# regardless of the developer's platform. Shell scripts run in the add-on's
# Alpine image for the same reason.
# `-whitespace` because a unified diff represents a blank context line as a single
# space, which `git diff --check` reports as trailing whitespace. That is a
# property of the diff format, not a defect in the patch.
*.patch text eol=lf -whitespace
*.sh text eol=lf

# Injected verbatim into the MQTT RAW topic. The add-on's input filter tests each
# payload with ishex(), so a trailing CR makes it drop the frame silently -- the
# worst possible failure for a corpus whose job is to prove frames are handled.
tests/fixtures/qds_walkby/*.txt text eol=lf

# Recorded output of the former bash bookkeeping (see tests/test_ledger_*.sh),
# compared byte for byte: LF regardless of platform, and `-whitespace` because
# TSV rows end with an empty field - a trailing TAB - by design.
tests/fixtures/ledger/** text eol=lf -whitespace
